# Read by `docker compose -f docker-compose.prod.yml` for its own ${VAR} substitution — this is
# separate from backend/.env, which the containers read at runtime for the app's own settings.
#
#   cp .env.example .env

# Required: the production Postgres password. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me

# Optional, default shown:
# POSTGRES_USER=tableflow
# POSTGRES_DB=tableflow
