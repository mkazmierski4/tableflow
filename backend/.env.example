# --- App ---
APP_NAME=TableFlow
APP_ENV=development            # development | test | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
# Dev (default): SQLite
DATABASE_URL=sqlite+aiosqlite:///./tableflow.db
# Docker / production: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://tableflow:tableflow@db:5432/tableflow

# --- Security ---
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (JSON list) ---
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006"]

# --- Reservation rules ---
RESERVATION_DEFAULT_DURATION_MINUTES=90
RESERVATION_MIN_LEAD_TIME_MINUTES=30
