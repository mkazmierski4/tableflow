# Base URL of the TableFlow API, without a trailing slash.
#
# Defaults when unset:
#   web, iOS simulator  -> http://localhost:8000
#   Android emulator    -> http://10.0.2.2:8000   (the emulator's alias for your computer)
# On a physical device use your computer's LAN address, e.g. http://192.168.1.20:8000
#
# For the web app, the backend must allow the dev origin in CORS_ORIGINS
# (backend/.env.example already lists http://localhost:8081).
EXPO_PUBLIC_API_URL=http://localhost:8000
